# ============================================================
# CRYPTOCONNECT - CONFIGURATION ENVIRONNEMENT
# ============================================================

# Environnement (development, production)
NODE_ENV=development

# Port du serveur
PORT=3000

# URL de base de l'application
APP_URL=http://localhost:3000

# ============================================================
# BASE DE DONNÉES MONGODB
# ============================================================
MONGODB_URI=mongodb://localhost:27017/cryptoconnect

# Pour MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cryptoconnect?retryWrites=true&w=majority

# ============================================================
# SÉCURITÉ & JWT
# ============================================================
JWT_SECRET=votre_secret_jwt_super_securise_changez_moi_123456789
JWT_REFRESH_SECRET=votre_refresh_secret_super_securise_changez_moi_987654321
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# GOOGLE OAUTH 2.0 AUTHENTICATION
# ============================================================
# Obtenez vos identifiants sur: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================================================
# SÉCURITÉ & RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# OPTIONS AVANCÉES
# ============================================================
# Niveau de log (error, warn, info, debug)
LOG_LEVEL=info

# Désactiver les messages détaillés en production
VERBOSE=true
